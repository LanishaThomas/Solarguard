/**
 * ======================================================================================
 * SolarGuard IoT - ESP32 Smart Solar Monitoring, Electricity Measuring,
 * Temperature Detection, Intelligent Flagging & Wiper Controller Firmware
 * ======================================================================================
 * 
 * Target Microcontroller: ESP32 (ESP32-WROOM-32 / DevKit V1)
 * Framework: Arduino ESP32
 * 
 * Hardware Breadboard Wiring:
 * --------------------------------------------------------------------------------------
 *  ESP32 Pin | Connection
 * -----------+--------------------------------------------------------------------------
 *  3V3       | VCC of all 3 INA219 modules and DS18B20 VDD
 *  GND       | Common ground rail (ESP32 GND, sensor rail, external 5V servo GND)
 *  GPIO 21   | SDA of all 3 INA219 modules (Shared I2C Data)
 *  GPIO 22   | SCL of all 3 INA219 modules (Shared I2C Clock)
 *  GPIO 4    | DS18B20 DATA (1-Wire Data line with 4.7 kΩ pull-up to 3V3)
 *  GPIO 18   | SG90 Signal wire (Orange/Yellow PWM signal wire)
 *  USB Port  | Powers ESP32 during development
 * --------------------------------------------------------------------------------------
 * 
 * ⚠️ CRITICAL NOTICE FOR 3x INA219 ADDRESSING:
 *  By default, all INA219 modules ship with the exact same address: 0x40.
 *  If unbridged, illuminating any panel will respond to address 0x40 (Panel 1).
 *  To measure each panel independently on GPIO 21/22:
 *    - Module 1 (Panel 1): Leave A0 & A1 open (Address: 0x40)
 *    - Module 2 (Panel 2): Solder bridge A0 pads together (Address: 0x41)
 *    - Module 3 (Panel 3): Solder bridge A1 pads together (Address: 0x44)
 * 
 *  This firmware features an Automatic I2C Address Scanner that scans all 16 INA219
 *  addresses (0x40 - 0x4F) and dynamically binds whichever addresses are detected!
 * ======================================================================================
 */

#include <WiFi.h>
#include <WiFiClientSecure.h>
