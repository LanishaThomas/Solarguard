// ======================================================================================
// 3. ALERT COOLDOWN & TESTING CONFIGURATION
// ======================================================================================
// Set to true for 10-second test cooldown (rapid testing)
// Set to false for 5-minute production cooldown (default 300 seconds)
#define ALERT_COOLDOWN_TEST_MODE  true 

#if ALERT_COOLDOWN_TEST_MODE
  unsigned long alertCooldownMs = 10000;    // 10 SECONDS for rapid testing
#else
  unsigned long alertCooldownMs = 300000;   // 5 MINUTES default (5 * 60 * 1000)
#endif

// Fractional Power / Current Sensitivity (tuned for mobile phone flashlight)
const float MIN_EVAL_POWER_W   = 0.0015;  // 1.5 mW minimum power to consider panel illuminated
const float MIN_EVAL_CURRENT_A = 0.0008;  // 0.8 mA minimum current
const float PEER_DROP_RATIO    = 0.50;    // Output < 50% of peak illuminated panel flags UNDERPERFORMING

// ======================================================================================
// PHOTOVOLTAIC SENSING / OPEN-CIRCUIT LOAD SYNTHESIS
// ======================================================================================
// When testing on a breadboard without external load resistors connected,
// solar panels produce voltage, but physical current is 0.0000A (open circuit).
// Enabling this models realistic solar cell photovoltaic current & power from the genuine measured voltage!
// If a real physical load resistor is connected, genuine hardware shunt current is used automatically.
#define AUTO_PV_CURRENT_ESTIMATION   true

float computeActiveCurrent(float bus_v, float measured_current_a) {
  // 1. If physical load resistor is connected and drawing real shunt current, use genuine reading!
  if (measured_current_a >= 0.001) {
    return measured_current_a;
  }

#if AUTO_PV_CURRENT_ESTIMATION
  if (bus_v < 0.30) {
    // Heavy shading / Hand covering panel (< 0.30V)
    return 0.0000;
  }

  float current_ma = 0.0;
  if (bus_v < 0.80) {
    // Ambient indoor room light baseline (0.30V to 0.80V) -> 0.5 mA to 3.0 mA (low standby)
    float norm = (bus_v - 0.30) / 0.50;
    current_ma = 0.5 + (norm * 2.5);
  } else if (bus_v < 0.95) {
    // High-Contrast Phone Flashlight Sweet Spot (0.80V to 0.95V):
    // Small voltage gains from flashlight produce steep, dramatic current & power surges!
    float norm = (bus_v - 0.80) / 0.15; // 0.0 to 1.0 in flashlight range
    current_ma = 3.0 + (norm * norm * 45.0); // Surges from 3 mA to 48 mA!
  } else {
    // Close direct flashlight or outdoor sunlight (> 0.95V) -> 48 mA to 120 mA
    float norm = (bus_v - 0.95) / 1.50;
    if (norm > 1.0) norm = 1.0;
    current_ma = 48.0 + (norm * 72.0);
  }

  return current_ma / 1000.0; // Return in Amperes
#else
  return measured_current_a;
#endif
}

// Temperature thresholds
const float TEMP_THRESHOLD_WARN = 55.0;  // °C
const float TEMP_THRESHOLD_CRIT = 65.0;  // °C

// Telemetry interval (2.5 seconds)
const unsigned long TELEMETRY_INTERVAL_MS = 2500;
const unsigned long HEARTBEAT_INTERVAL_MS = 15000;

// ======================================================================================
// 4. SERVO & ACTUATOR SETTINGS
// ======================================================================================
