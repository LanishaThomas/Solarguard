# ==========================================
# SolarGuard Environment Configuration
# ==========================================

# 1. MongoDB Database Connection (Backend only)
# Add your MongoDB Atlas connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=solarguard_db

# 2. AI Model Configuration
MODEL_FILENAME=solarguard_mobilenetv3_50epoch_finetuned.pt
CONFIDENCE_THRESHOLD=0.50
CRACK_THRESHOLD=0.40

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
PYTHON_VERSION=3.10.12

# 4. Hidden AI Detection Service (Set in Render Dashboard environment variables)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 5. Frontend API Endpoint (Set in Vercel project environment variables)
# VITE_BACKEND_URL=https://solarguard-backend.onrender.com

# 6. EMQX Cloud MQTT Broker Configuration (ESP32 & Web App)
# Deployment Address: v20f2113.ala.asia-southeast1.emqxsl.com
# React Web App: WebSocket TLS (WSS) on Port 8084
# ESP32 Firmware: MQTT TLS on Port 8883
VITE_EMQX_BROKER=v20f2113.ala.asia-southeast1.emqxsl.com
VITE_EMQX_PORT=8084
VITE_EMQX_USE_TLS=true
VITE_EMQX_PATH=/mqtt
VITE_EMQX_USERNAME=your_emqx_username
VITE_EMQX_PASSWORD=your_emqx_password
VITE_EMQX_TOPIC_PREFIX=solarguard

# Backend / Python scripts (TCP/TLS Client)
EMQX_BROKER=v20f2113.ala.asia-southeast1.emqxsl.com
EMQX_PORT=8883
EMQX_USERNAME=your_emqx_username
EMQX_PASSWORD=your_emqx_password
EMQX_TOPIC_PREFIX=solarguard

